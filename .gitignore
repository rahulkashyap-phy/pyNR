# ===================================================================== Python, tools, OS
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store

# Numba on-disk JIT cache (cache=True writes next to the sources, or to $NUMBA_CACHE_DIR)
*.nbi
*.nbc
.numba_cache/

# ===================================================================== simulation output
# Default output root of a checkout (pynr/paths.py): pynr run / notebooks -> simulations/<run>/
/simulations/
# Older default (out_dir relative to the current directory) and notebook-local runs
/gauge_wave/
/linear_wave/
/kerr_schild/
/schwarzschild_*/
notebooks/*/
# Files every run writes (anywhere): grid functions, reductions, multipoles, run metadata
*.h5
*.asc
pynr.log
parameters.par

# ===================================================================== generated at docs build time
# Sphinx output: HTML site and PDF lecture notes (docs/_build/html, docs/_build/latex)
docs/_build/
# arch/render.py, check_drift.py, docs/_ext/docgraph.py, conf.py: diagrams (.dot), workflows, component
# table, problem matrix, drift report, extracted.json, explorer data, API index, docgraph.json
docs/_generated/
# scripts/make_doc_figures.py: figure PNGs and their run-settings snippets, drawn from docs/data/
docs/figures/
# `pynr thorns --markdown` (generated by the docs workflow and before local builds)
docs/reference/parameters.md
# autosummary stub pages (not used: the API index uses tables only)
docs/reference/_autosummary/

# ===================================================================== documentation data (docs/data/)
# Only the files the figures are drawn from (~92 KB) and the parameter files that produced them are
# tracked; everything else that `make_doc_figures.py save` copies there stays local.
# See docs/reproducing-figures.md.
docs/data/**
!docs/data/**/
!docs/data/**/*.par
docs/data/**/parameters.par
!docs/data/gauge_wave/*/alp_profile.dat
!docs/data/gauge_wave/dx0.02_t10/parameters.par
!docs/data/gauge_wave/dx0.02_t10/pynr.log
!docs/data/kerr_schild/H.norm2.asc
!docs/data/kerr_schild/H.maximum.asc
!docs/data/kerr_schild/parameters.par
!docs/data/kerr_schild/pynr.log
!docs/data/schwarzschild_perturbed/mp_Psi4_l2_m0_r6.00.asc
!docs/data/schwarzschild_perturbed/mp_Psi4_l4_m0_r6.00.asc
!docs/data/schwarzschild_perturbed/parameters.par
!docs/data/schwarzschild_perturbed/pynr.log
