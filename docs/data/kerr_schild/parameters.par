Cactus::terminate = "time"
Cactus::cctk_itlast = 10
Cactus::cctk_final_time = 40.0
CoordBase::xmin = -8.125
CoordBase::xmax = 8.125
CoordBase::ymin = -8.125
CoordBase::ymax = 8.125
CoordBase::zmin = -8.125
CoordBase::zmax = 8.125
CoordBase::dx = 0.25
CoordBase::dy = 0.25
CoordBase::dz = 0.25
CoordBase::periodic_x = no
CoordBase::periodic_y = no
CoordBase::periodic_z = no
Driver::ghost_size = 3
Driver::backend = "numba"
Time::timestep_method = "courant_static"
Time::dtfac = 0.25
Time::timestep = 0.0
IO::out_dir = "kerr_schild"
ADMBase::initial_data = "exact"
ADMBase::initial_lapse = "exact"
ADMBase::initial_shift = "exact"
ADMBase::evolution_method = "ADMEvolve"
ADMBase::lapse_evolution_method = "static"
ADMBase::shift_evolution_method = "static"
Exact::exact_model = "Kerr/Kerr-Schild"
Exact::Minkowski_gauge_wave__amplitude = 0.1
Exact::Minkowski_gauge_wave__lambda = 1.0
Exact::Minkowski_linear_wave__amplitude = 1e-08
Exact::Minkowski_linear_wave__lambda = 1.0
Exact::Schwarzschild_isotropic__mass = 1.0
Exact::Kerr_KerrSchild__mass = 1.0
Exact::Kerr_KerrSchild__spin = 0.6
Exact::position_x = 0.0
Exact::position_y = 0.0
Exact::position_z = 0.0
MoL::ODE_Method = "RK4"
MoL::check_nan_every = 10
MoL::abort_above = 10000000000.0
ADMEvolve::bound = "static"
ADMEvolve::advect_lapse = yes
ADMEvolve::excision_radius = 1.6
Dissipation::epsdis = 0.3
ADMConstraints::compute = yes
IOHDF5::out_every = 320
IOHDF5::out_vars = "ADMBase::gxx"
IOHDF5::out2D_every = 40
IOHDF5::out2D_vars = "ADMBase::gxx ADMBase::kxx ADMConstraints::H"
IOHDF5::out2D_planes = "xy xz yz"
IOScalar::outScalar_every = 2
IOScalar::outScalar_vars = "ADMBase::metric ADMConstraints::H"
IOScalar::outScalar_reductions = "minimum maximum norm2"
IOBasic::outInfo_every = 40
IOBasic::outInfo_vars = "ADMBase::gxx ADMConstraints::H"
