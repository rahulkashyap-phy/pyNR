Cactus::terminate = "time"
Cactus::cctk_itlast = 10
Cactus::cctk_final_time = 36.0
CoordBase::xmin = -16.125
CoordBase::xmax = 16.125
CoordBase::ymin = -16.125
CoordBase::ymax = 16.125
CoordBase::zmin = -16.125
CoordBase::zmax = 16.125
CoordBase::dx = 0.25
CoordBase::dy = 0.25
CoordBase::dz = 0.25
CoordBase::periodic_x = no
CoordBase::periodic_y = no
CoordBase::periodic_z = no
Driver::ghost_size = 3
Driver::backend = "numba"
Time::timestep_method = "courant_static"
Time::dtfac = 0.25
Time::timestep = 0.0
IO::out_dir = "schwarzschild_perturbed"
ADMBase::initial_data = "exact"
ADMBase::initial_lapse = "exact"
ADMBase::initial_shift = "exact"
ADMBase::evolution_method = "ADMEvolve"
ADMBase::lapse_evolution_method = "static"
ADMBase::shift_evolution_method = "static"
Exact::exact_model = "Kerr/Kerr-Schild"
Exact::Minkowski_gauge_wave__amplitude = 0.1
Exact::Minkowski_gauge_wave__lambda = 1.0
Exact::Minkowski_linear_wave__amplitude = 1e-08
Exact::Minkowski_linear_wave__lambda = 1.0
Exact::Schwarzschild_isotropic__mass = 1.0
Exact::Kerr_KerrSchild__mass = 1.0
Exact::Kerr_KerrSchild__spin = 0.0
Exact::position_x = 0.0
Exact::position_y = 0.0
Exact::position_z = 0.0
Perturb::amplitude = 0.001
Perturb::radius = 4.0
Perturb::width = 1.0
Perturb::l = 2
Perturb::m = 0
Perturb::center_x = 0.0
Perturb::center_y = 0.0
Perturb::center_z = 0.0
MoL::ODE_Method = "RK4"
MoL::check_nan_every = 10
MoL::abort_above = 10000000000.0
ADMEvolve::bound = "radiative"
ADMEvolve::advect_lapse = yes
ADMEvolve::excision_radius = 1.8
Dissipation::epsdis = 0.3
ADMConstraints::compute = yes
WeylScal4::offset_x = 0.0
WeylScal4::offset_y = 0.0
WeylScal4::offset_z = 0.0
Multipole::variables = "WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='Psi4'}"
Multipole::nradii = 2
Multipole::radius[0] = 6.0
Multipole::radius[1] = 8.0
Multipole::radius[2] = 10.0
Multipole::radius[3] = 10.0
Multipole::radius[4] = 10.0
Multipole::radius[5] = 10.0
Multipole::radius[6] = 10.0
Multipole::radius[7] = 10.0
Multipole::radius[8] = 10.0
Multipole::radius[9] = 10.0
Multipole::radius[10] = 10.0
Multipole::radius[11] = 10.0
Multipole::radius[12] = 10.0
Multipole::radius[13] = 10.0
Multipole::radius[14] = 10.0
Multipole::radius[15] = 10.0
Multipole::l_max = 4
Multipole::out_every = 4
Multipole::geodesic_level = 4
Multipole::interpolator_order = 3
Multipole::center_x = 0.0
Multipole::center_y = 0.0
Multipole::center_z = 0.0
IOHDF5::out_every = 0
IOHDF5::out_vars = ""
IOHDF5::out2D_every = 80
IOHDF5::out2D_vars = "ADMBase::gxx WeylScal4::Psi4r ADMConstraints::H"
IOHDF5::out2D_planes = "xy xz yz"
IOScalar::outScalar_every = 4
IOScalar::outScalar_vars = "ADMBase::gxx ADMConstraints::H"
IOScalar::outScalar_reductions = "minimum maximum norm2"
IOBasic::outInfo_every = 40
IOBasic::outInfo_vars = "ADMBase::alp ADMConstraints::H"
